# ---------------------------------------------------------------------
# Server-side only. These are read by the /api functions and must never
# be exposed to the browser — note the absence of any VITE_ prefix,
# which is what would make Vite inline them into the bundle.
# ---------------------------------------------------------------------

# Neon. Use the POOLED connection string (…-pooler.…) for the app: a
# serverless function opens a connection per invocation.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Migrations in db/*.sql go over the DIRECT endpoint instead (same host
# without `-pooler`). They are schema changes, not concurrent traffic.

# Signs session tokens. 32+ characters. Rotating it logs everyone out.
JWT_SECRET=change-me-to-at-least-32-random-characters

# Optional
SESSION_TTL_SECONDS=43200   # 12h; still capped by the tenant's expiry
PGPOOL_MAX=3                # keep small: serverless opens many instances

# ---------------------------------------------------------------------
# Client-side (bundled — nothing secret here)
# ---------------------------------------------------------------------
VITE_POLL_MS=4000           # live-view refresh interval
